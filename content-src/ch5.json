[
{"id":"c5-density-constant","ch":5,"sec":"5.1","title":"The Shaped Fog","scene":"oracle-tower","boss":false,"vars":{},
 "story":"A fog's position X has density f(x) = c(1 − x²) on (−1, 1).",
 "phases":[{"ask":"c?","f":"3/4","answer":0.75,"tol":{"rel":0.0005}},
  {"ask":"P(X > 0.5)?","f":"0.75*((1-0.5)-(1-0.5^3)/3)","answer":0.15625,"tol":{"abs":0.0005}}],
 "hints":["A density must integrate to 1.","Integrate the density from 0.5 to 1."],
 "solution":["∫(1 − x²)dx over (−1,1) = 4/3 → c = 3/4.","¾[(1 − 0.5) − (1 − 0.125)/3] = 0.15625."],
 "pattern":"normalise, then integrate","mirrors":["P5.1","P5.3","P5.4","ST5.2","ST5.3"],"vary":{}},
{"id":"c5-moments","ch":5,"sec":"5.2","title":"The Leaning Tower","scene":"oracle-tower","boss":false,"vars":{},
 "story":"X has density f(x) = 2x on (0, 1).",
 "phases":[{"ask":"E[X]?","f":"2/3","answer":0.6666666667,"tol":{"rel":0.0005}},
  {"ask":"Var(X)?","f":"1/2-(2/3)^2","answer":0.0555555556,"tol":{"rel":0.0005}}],
 "hints":["E[X] = ∫x f(x)dx; E[X²] = ∫x² f(x)dx."],
 "solution":["E = 2/3, E[X²] = 1/2, Var = 1/18."],
 "pattern":"moments by integration","mirrors":["P5.6","P5.7","P5.8","ST5.4","P5.2"],"vary":{}},
{"id":"c5-bus-stop","ch":5,"sec":"5.3","title":"The Coach Stop","scene":"bus-stop","boss":false,"vars":{"T":20,"w":5,"t0":8,"more":6},
 "story":"The coach arrives at a time uniform over the next {T} minutes.",
 "phases":[{"ask":"P(you wait more than {w} minutes)?","f":"(T-w)/T","answer":0.75,"tol":{"abs":0.0005}},
  {"ask":"It hasn't come after {t0} minutes. P(you wait at least {more} more)?","f":"(T-t0-more)/(T-t0)","answer":0.5,"tol":{"rel":0.0005}}],
 "hints":["Uniform: probability = length/total length.","Given it hasn't come by t0, the arrival is uniform on what's left."],
 "solution":["(T − w)/T.","Uniform on (t0, T): (T − t0 − more)/(T − t0). Unlike the exponential, this has memory!"],
 "pattern":"uniform: length ratios; conditioning keeps it uniform","mirrors":["P5.13","P5.10","P5.11","P5.12"],"vary":{"T":{"min":15,"max":30},"w":{"min":3,"max":8}}},
{"id":"c5-uniform-params","ch":5,"sec":"5.3","title":"The Hidden Range","scene":"forge","boss":false,"vars":{"m":12,"v":27},
 "story":"X is uniform on (a, b) with E[X] = {m} and Var(X) = {v}.",
 "phases":[{"ask":"a?","f":"m-sqrt(3*v)","answer":3,"tol":{"rel":0.0005}},
  {"ask":"b?","f":"m+sqrt(3*v)","answer":21,"tol":{"rel":0.0005}}],
 "hints":["Var = (b − a)²/12 and E = (a + b)/2."],
 "solution":["b − a = √(12v), centred at m."],
 "pattern":"uniform moments","mirrors":["P5.41","P5.14"],"vary":{}},
{"id":"c5-archery-normal","ch":5,"sec":"5.4","title":"The Archery Range","scene":"archery-range","boss":false,"vars":{"mu":50,"s":8,"x":62},
 "story":"Your arrows land at a distance ~ N({mu}, {s}²) from the line.",
 "phases":[{"ask":"P(an arrow lands beyond {x})?","f":"1-Phi((x-mu)/s)","answer":0.0668072013,"tol":{"abs":0.006}},
  {"ask":"P(within one σ of the mean)?","f":"Phi(1)-Phi(-1)","answer":0.6826894921,"tol":{"abs":0.006}}],
 "hints":["Standardise: Z = (X − μ)/σ, then use the Φ-scroll."],
 "solution":["1 − Φ((x − μ)/σ).","≈ 0.6827."],
 "pattern":"standardise → Φ","mirrors":["P5.15","P5.16","P5.21","P5.24","ST5.9","ST5.11"],"vary":{"x":{"min":52,"max":70}}},
{"id":"c5-normal-cutoff","ch":5,"sec":"5.4","title":"The Top 5%","scene":"archery-range","boss":false,"vars":{"mu":100,"s":15},
 "story":"Mage-trial scores are N({mu}, {s}²). Only the top 5% earn a staff.",
 "phases":[{"ask":"What is the cutoff score? (Use z = 1.645.)","f":"mu+1.645*s","answer":124.675,"tol":{"rel":0.0005}}],
 "hints":["Find z with Φ(z) = 0.95, then un-standardise."],
 "solution":["μ + 1.645σ."],
 "pattern":"inverse normal: x = μ + zσ","mirrors":["P5.17","P5.18","P5.19","ST5.8"],"vary":{}},
{"id":"c5-normal-approx","ch":5,"sec":"5.4.1","title":"Six Hundred Rolls","scene":"dice-table","boss":true,"vars":{"n":600,"lo":90,"hi":110},
 "story":"A die is rolled {n} times. Let X = the number of sixes.",
 "phases":[{"ask":"Normal approximation (with continuity correction) of P({lo} ≤ X ≤ {hi})?","f":"Phi((hi+0.5-n/6)/sqrt(n*5/36))-Phi((lo-0.5-n/6)/sqrt(n*5/36))","answer":0.7499456466,"tol":{"abs":0.006}}],
 "hints":["μ = np, σ = √(np(1−p)).","Integer values from lo to hi → stretch the interval to lo − 0.5 and hi + 0.5."],
 "solution":["μ = 100, σ ≈ 9.13; Φ(1.15) − Φ(−1.15) ≈ 0.750."],
 "pattern":"binomial ≈ normal with ±0.5","mirrors":["P5.20","P5.23","P5.25","P5.28","P5.22","P5.26","P5.27"],"vary":{}},
{"id":"c5-exponential","ch":5,"sec":"5.5","title":"The Ferryman's Service","scene":"bus-stop","boss":false,"vars":{"m":4,"t":6,"a":3},
 "story":"The ferryman's service time is exponential with mean {m} minutes.",
 "phases":[{"ask":"P(service takes more than {t} minutes)?","f":"e^(-t/m)","answer":0.2231301601,"tol":{"abs":0.0005}},
  {"ask":"You have already waited {a} minutes. P(more than {t} additional minutes)?","f":"e^(-t/m)","answer":0.2231301601,"tol":{"rel":0.0005}}],
 "hints":["Exponential: P(X > t) = e^(−λt) with λ = 1/mean.","Memoryless."],
 "solution":["e^(−t/m).","Same: the exponential forgets the past."],
 "pattern":"exponential is memoryless","mirrors":["P5.32","P5.34","P5.35","ST5.13","ST5.18"],"vary":{}},
{"id":"c5-hazard","ch":5,"sec":"5.5.1","title":"The Ageing Golem","scene":"forge","boss":false,"vars":{"t1":1,"t2":1.5},
 "story":"A golem's hazard rate is λ(t) = t² (it wears out faster as it ages).",
 "phases":[{"ask":"P(it survives to {t2} | alive at {t1})?","f":"exp(-(t2^3-t1^3)/3)","answer":0.4530890173,"tol":{"abs":0.0005}}],
 "hints":["P(X > t) = exp(−∫₀ᵗ λ(s)ds)."],
 "solution":["exp(−(t2³ − t1³)/3)."],
 "pattern":"survival from hazard","mirrors":["P5.36","P5.37","ST5.15"],"vary":{}},
{"id":"c5-transform","ch":5,"sec":"5.7","title":"The Log Transmutation","scene":"forge","boss":false,"vars":{"y":2},
 "story":"U is uniform on (0, 1). The alchemist forms Y = −ln U.",
 "phases":[{"ask":"P(Y > {y})?","f":"e^(-y)","answer":0.1353352832,"tol":{"abs":0.0005}}],
 "hints":["Y > y ⇔ U < e^(−y)."],
 "solution":["P(U < e^(−y)) = e^(−y): Y is Exp(1)."],
 "pattern":"CDF method for Y = g(X)","mirrors":["P5.33","P5.40","P5.42","P5.38","ST5.22"],"vary":{"y":{"min":1,"max":4}}},
{"id":"c5-real-roots","ch":5,"sec":"5.3","title":"The Root Riddle","scene":"oracle-tower","boss":true,"vars":{"L":8},
 "story":"Y is uniform on (0, {L}). Consider 4x² + 4Yx + (Y + 6) = 0.",
 "phases":[{"ask":"P(both roots are real)?","f":"(L-3)/L","answer":0.625,"tol":{"abs":0.0005}}],
 "hints":["Real roots ⇔ discriminant ≥ 0. Turn that into a condition on Y."],
 "solution":["16Y² − 16(Y + 6) ≥ 0 ⇔ (Y − 3)(Y + 2) ≥ 0 ⇔ Y ≥ 3 → (L − 3)/L."],
 "pattern":"turn the event into an interval","mirrors":["P5.39"],"vary":{"L":{"min":4,"max":10}}},
{"id":"c5-tyres","ch":5,"sec":"5.4","title":"Wagon Wheels","scene":"archery-range","boss":false,"vars":{"mu":40000,"s":5000},
 "story":"Wagon-wheel lifetimes are N({mu}, {s}²) leagues.",
 "phases":[{"ask":"P(a wheel lasts beyond 48000)?","f":"1-Phi((48000-mu)/s)","answer":0.0547992917,"tol":{"abs":0.006}},
  {"ask":"P(lasts beyond 48000 | it has already lasted 45000)?","f":"(1-Phi((48000-mu)/s))/(1-Phi((45000-mu)/s))","answer":0.3453985314,"tol":{"abs":0.006}}],
 "hints":["Conditional = P(both) / P(given). Here 'beyond 48000' implies 'beyond 45000'."],
 "solution":["Ratio of the two normal tails."],
 "pattern":"conditioning on a tail","mirrors":["ST5.10","ST5.12"],"vary":{}}
]
