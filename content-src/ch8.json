{"id":"c8-dice-army","ch":8,"sec":"8.3","title":"The Hundred-Dice Army","scene":"marching-army","boss":true,"vars":{"n":100,"s":370},
 "story":"{n} soldiers each roll a die; the general sums the results.",
 "phases":[{"ask":"CLT (with continuity correction): P(sum ≥ {s})?","f":"1-Phi((s-0.5-3.5*n)/sqrt(n*35/12))","answer":0.1267679398,"tol":{"abs":0.006}}],
 "hints":["One die: μ = 3.5, σ² = 35/12. A sum of n dice: nμ, nσ²."],
 "solution":["μ = 350, σ ≈ 17.08 → 1 − Φ((369.5 − 350)/17.08) ≈ 0.127."],
 "pattern":"CLT for sums","mirrors":["P8.6","P8.4","Ex3"],"vary":{}},
{"id":"c8-rounding","ch":8,"sec":"8.3","title":"The Tax Collector's Rounding","scene":"marching-army","boss":false,"vars":{"n":48,"d":3},
 "story":"{n} amounts are rounded to the nearest coin; each error is uniform on (−½, ½).",
 "phases":[{"ask":"P(the total error exceeds {d} in absolute value)?","f":"2*(1-Phi(d/sqrt(n/12)))","answer":0.1336144025,"tol":{"abs":0.006}}],
 "hints":["Var of one uniform(−½, ½) error = 1/12."],
 "solution":["σ = √(n/12) = 2 → 2(1 − Φ(1.5)) ≈ 0.134."],
 "pattern":"CLT for sums of uniforms","mirrors":["P8.5"],"vary":{}},
{"id":"c8-lanterns","ch":8,"sec":"8.3","title":"Lanterns Through the Night","scene":"marching-army","boss":false,"vars":{"n":60,"m":4,"T":260},
