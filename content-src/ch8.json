{"id":"c8-sample-size","ch":8,"sec":"8.3","title":"How Many Recruits?","scene":"marching-army","boss":true,"vars":{"s":14,"d":2},
 "story":"Recruit scores have standard deviation {s}. How many recruits are needed so that their average is within {d} of the true mean with 95% probability?",
 "phases":[{"ask":"Smallest n (CLT, z = 1.96)?","f":"189","answer":189,"tol":{"rel":0.0005}}],
 "hints":["Solve 1.96·σ/√n ≤ d for n."],
 "solution":["n ≥ (1.96·14/2)² = 188.2 → 189."],
 "pattern":"sample size from the CLT","mirrors":["P8.13","P8.2","P8.3"],"vary":{}},
{"id":"c8-gambler","ch":8,"sec":"8.3","title":"The Hundred Wagers","scene":"wheel","boss":true,"vars":{},
 "story":"Each wager: lose 1 (0.7), lose 2 (0.2), or win 10 (0.1). You make 100 wagers.",
 "phases":[{"ask":"Mean of one wager?","f":"-0.7-0.4+1","answer":-0.1,"tol":{"rel":0.0005}},
  {"ask":"CLT: P(you're ahead after 100 wagers)?","f":"1-Phi((0.5-100*(-0.1))/sqrt(100*(11.5-0.01)))","answer":0.3783706648,"tol":{"abs":0.006}}],
 "hints":["Var = E[X²] − (E[X])².","Ahead means total ≥ 1; use the continuity correction at 0.5."],
 "solution":["E = −0.1, Var = 11.49.","P ≈ 1 − Φ(0.31) ≈ 0.378."],
 "pattern":"CLT on a skewed bet","mirrors":["ST8.8","ST8.12"],"vary":{}},
{"id":"c8-wlln","ch":8,"sec":"8.2","title":"The Law Itself","scene":"marching-army","boss":false,"vars":{"eps":0.05,"a":0.1},
 "story":"A fair coin is flipped n times. Using Chebyshev, how large must n be so that P(|average − ½| ≥ {eps}) ≤ {a}?",
 "phases":[{"ask":"Smallest n guaranteed by Chebyshev?","f":"0.25/(a*eps^2)","answer":1000,"tol":{"rel":0.0005}}],
 "hints":["Var(average) = (1/4)/n."],
 "solution":["(1/4)/(n·ε²) ≤ a → n ≥ 1/(4aε²) = 1000."],
 "pattern":"weak law via Chebyshev","mirrors":["8.2","ST8.13"],"vary":{}},
