{"id":"c8-insurer","ch":8,"sec":"8.3","title":"The Guild Insurer","scene":"marching-army","boss":false,"vars":{"n":10000,"m":240,"s":800,"T":2450000},
 "story":"{n} policies each have a yearly claim with mean {m} and standard deviation {s}.",
 "phases":[{"ask":"P(total claims exceed {T})?","f":"1-Phi((T-n*m)/(s*sqrt(n)))","answer":0.265985529,"tol":{"abs":0.006}}],
